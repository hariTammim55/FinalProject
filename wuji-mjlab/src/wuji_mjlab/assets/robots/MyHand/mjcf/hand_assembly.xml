<?xml version="1.0" encoding="utf-8"?>
<mujoco model="MyHand_11Actuators">

  <!--
    MyHand RL model - RUKA tendon version (11 actuators, DIP coupled to PIP).
    Copied from myHand/mjcf/hand_assembly.xml; only <actuator> and <equality> differ.
    Geometry, body transforms, masses and inertias are retained from the user's XML.
    Joint ranges are derived from the existing actuator ctrlrange values:
      MCP: 2.44222 rad ~= 139.93 deg
      finger DIP/PIP and thumb IP: 2.09 rad ~= 119.75 deg
      thumb CMC: 3.314 rad ~= 189.90 deg
      thumb MCP: 1.57 rad ~= 90 deg
    These are provisional simulation limits and must be checked against the CAD/mechanical stops.
  -->

  <compiler angle="degree" eulerseq="xyz" meshdir="../meshes" autolimits="true"/>

  <option
      gravity="0 0 -9.81"
      jacobian="sparse"
      integrator="RK4"
      timestep="0.002"
      solver="Newton"
      iterations="50"
      tolerance="1e-10"/>

  <visual>
    <global azimuth="180" elevation="-20"/>
    <headlight ambient="0.3 0.3 0.3" diffuse="0.6 0.6 0.6" specular="0 0 0"/>
  </visual>

  <asset>
    <mesh name="Palm" file="Palm.STL"/>
    <mesh name="Index_MCP" file="Index_MCP.STL"/>
