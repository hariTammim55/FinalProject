  <contact>
    <!-- Retain the original palm-to-proximal-finger exclusions. -->
    <exclude body1="Palm_Link" body2="Thumb_CMC_Link"/>
    <exclude body1="Palm_Link" body2="Ring_MCP_Link"/>
    <exclude body1="Palm_Link" body2="Pinky_MCP_Link"/>
    <exclude body1="Palm_Link" body2="Middle_MCP_Link"/>
    <exclude body1="Palm_Link" body2="Index_MCP_Link"/>
  </contact>

  <actuator>
    <!--
      RUKA tendon actuation: 11 servos (12 V, no current limit).
        fingers: XM430-W210-T (stall 3.0 N*m), thumb: XM430-W350-T (4.1 N*m)
        tendon spool diameter 25.5 mm (radius r_p = 12.75 mm)
      Each finger: one servo on MCP, ONE tendon pulling PIP and DIP together.
      NOTE the MJCF names: *_DIP_Joint is the middle joint (anatomical PIP,
      driven) and *_PIP_Joint the tip joint (anatomical DIP), which follows it
      through the <equality> below. Thumb: one servo per joint.

      Per driven joint with tendon moment arm r_j (m):
        forcerange = stall / r_p * r_j                       (joint torque limit)
        kp = (KPP/128) * (4096/2pi) / 885 * stall * (r_j/r_p)^2
             with KPP = 800 = Dynamixel Position P Gain (factory default),
             so keep the real servos at P Gain 800 for sim2real.
        kv = 0.0504 * kp  (same kv/kp ratio as the 15-actuator model)
      Moment arms (from RUKA's calibrated motor ranges, +-30%):
        finger MCP 8.4 mm, finger PIP+DIP 12.4 mm (sum over both joints),
        thumb CMC 5.3 mm, MCP 7.5 mm, IP 5.3 mm.
      Recompute with assets/robots/MyHand/my_hand_cfg.py
      (servo_actuator_params) when the moment arms or servo limits change.
    -->
    <position name="Index_MCP_actuator" joint="Index_MCP_Joint"
              kp="5.9948" kv="0.3021" ctrlrange="0 2.44222"
              forcelimited="true" forcerange="-1.9765 1.9765"/>
    <position name="Index_PIPDIP_actuator" joint="Index_DIP_Joint"
              kp="13.0635" kv="0.6584" ctrlrange="0 2.09"
              forcelimited="true" forcerange="-2.9176 2.9176"/>

    <position name="Middle_MCP_actuator" joint="Middle_MCP_Joint"
              kp="5.9948" kv="0.3021" ctrlrange="0 2.44222"
              forcelimited="true" forcerange="-1.9765 1.9765"/>
    <position name="Middle_PIPDIP_actuator" joint="Middle_DIP_Joint"
              kp="13.0635" kv="0.6584" ctrlrange="0 2.09"
              forcelimited="true" forcerange="-2.9176 2.9176"/>

    <position name="Ring_MCP_actuator" joint="Ring_MCP_Joint"
              kp="5.9948" kv="0.3021" ctrlrange="0 2.44222"
              forcelimited="true" forcerange="-1.9765 1.9765"/>
    <position name="Ring_PIPDIP_actuator" joint="Ring_DIP_Joint"
              kp="13.0635" kv="0.6584" ctrlrange="0 2.09"
              forcelimited="true" forcerange="-2.9176 2.9176"/>

    <position name="Pinky_MCP_actuator" joint="Pinky_MCP_Joint"
              kp="5.9948" kv="0.3021" ctrlrange="0 2.44222"
              forcelimited="true" forcerange="-1.9765 1.9765"/>
    <position name="Pinky_PIPDIP_actuator" joint="Pinky_DIP_Joint"
              kp="13.0635" kv="0.6584" ctrlrange="0 2.09"
              forcelimited="true" forcerange="-2.9176 2.9176"/>

    <position name="Thumb_CMC_actuator" joint="Thumb_CMC_Joint"
              kp="3.2616" kv="0.1644" ctrlrange="0 3.314"
              forcelimited="true" forcerange="-1.7043 1.7043"/>
    <position name="Thumb_MCP_actuator" joint="Thumb_MCP_Joint"
              kp="6.5313" kv="0.3292" ctrlrange="0 1.57"
              forcelimited="true" forcerange="-2.4118 2.4118"/>
    <position name="Thumb_IP_actuator" joint="Thumb_IP_Joint"
              kp="3.2616" kv="0.1644" ctrlrange="0 2.09"
              forcelimited="true" forcerange="-1.7043 1.7043"/>
  </actuator>

  <equality>
    <!-- Tip joint follows the middle joint 1:1 (one tendon over both). -->
    <joint name="Index_PIP_DIP_coupling" joint1="Index_PIP_Joint" joint2="Index_DIP_Joint" polycoef="0 1 0 0 0"/>
    <joint name="Middle_PIP_DIP_coupling" joint1="Middle_PIP_Joint" joint2="Middle_DIP_Joint" polycoef="0 1 0 0 0"/>
    <joint name="Ring_PIP_DIP_coupling" joint1="Ring_PIP_Joint" joint2="Ring_DIP_Joint" polycoef="0 1 0 0 0"/>
    <joint name="Pinky_PIP_DIP_coupling" joint1="Pinky_PIP_Joint" joint2="Pinky_DIP_Joint" polycoef="0 1 0 0 0"/>
  </equality>

</mujoco>