    <mesh name="Middle_DIP" file="Middle_DIP.STL"/>
    <mesh name="Middle_PIP" file="Middle_PIP.STL"/>
    <mesh name="Ring_MCP" file="Ring_MCP.STL"/>
    <mesh name="Ring_DIP" file="Ring_DIP.STL"/>
    <mesh name="Ring_PIP" file="Ring_PIP.STL"/>
    <mesh name="Pinky_MCP" file="Pinky_MCP.STL"/>
    <mesh name="Pinky_DIP" file="Pinky_DIP.STL"/>
    <mesh name="Pinky_PIP" file="Pinky_PIP.STL"/>
    <mesh name="Thumb_CMC" file="Thumb_CMC.STL"/>
    <mesh name="Thumb_MCP" file="Thumb_MCP.STL"/>
    <mesh name="Thumb_IP" file="Thumb_IP.STL"/>

    <material name="contact_point_material" rgba="0.737 0.285 0.251 1" specular="0"/>
    <texture name="grid" type="2d" builtin="checker"
             rgb1=".1 .2 .3" rgb2=".2 .3 .4" width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="100 100" reflectance=".2"/>
  </asset>

  <default>
    <default class="visual">
      <geom group="1"
            friction="1 0.005 0.001"
            conaffinity="0"
            contype="0"
            condim="3"
            density="0"/>
    </default>

    <default class="joint">
      <joint damping="0.0" armature="0.001" frictionloss="0.01"/>
