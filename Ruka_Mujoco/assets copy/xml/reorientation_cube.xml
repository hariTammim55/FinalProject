<mujoco model="reorientation_cube">

    <!-- ========================================================= -->
    <!-- GENERAL OPTIONS                                           -->
    <!-- ========================================================= -->

    <compiler angle="radian"/>

    <option
        gravity="0 -9.81 0"
        timestep="0.002"
        integrator="implicitfast"
    />


    <!-- ========================================================= -->
    <!-- DEFAULT SETTINGS                                          -->
    <!-- ========================================================= -->

    <default>

        <!-- Default class for the cube -->
        <default class="cube">

            <!--
                Default physical properties for collision geometry.
            -->
            <geom
                friction="1.0 0.01 0.001"
                condim="3"
                contype="1"
                conaffinity="2"
            />

        </default>

    </default>


    <!-- ========================================================= -->
    <!-- ASSETS                                                    -->
    <!-- ========================================================= -->

    <asset>

        <!-- ===================================================== -->
        <!-- NORMAL CUBE TEXTURE                                   -->
        <!-- ===================================================== -->

        <texture
            name="cube"
            type="cube"
            fileup="reorientation_cube_textures/fileup.png"
            fileback="reorientation_cube_textures/fileback.png"
            filedown="reorientation_cube_textures/filedown.png"
            filefront="reorientation_cube_textures/filefront.png"
            fileleft="reorientation_cube_textures/fileleft.png"
            fileright="reorientation_cube_textures/fileright.png"
        />

        <material
            name="cube"
            texture="cube"
        />


        <!-- ===================================================== -->
        <!-- GRAY CUBE TEXTURE                                     -->
        <!-- ===================================================== -->

        <texture
            name="graycube"
            type="cube"
            fileup="reorientation_cube_textures/grayup.png"
            fileback="reorientation_cube_textures/grayback.png"
            filedown="reorientation_cube_textures/graydown.png"
            filefront="reorientation_cube_textures/grayfront.png"
            fileleft="reorientation_cube_textures/grayleft.png"
            fileright="reorientation_cube_textures/grayright.png"
        />

        <material
            name="graycube"
            texture="graycube"
        />


        <!-- ===================================================== -->
        <!-- DEXTERITY CUBE TEXTURE                                -->
        <!-- ===================================================== -->

        <texture
            name="dexcube"
            type="2d"
            file="reorientation_cube_textures/dex_cube.png"
        />

        <material
            name="dexcube"
            texture="dexcube"
            texuniform="true"
        />


        <!-- ===================================================== -->
        <!-- CUBE MESH                                              -->
        <!-- ===================================================== -->

        <mesh
            name="cube_mesh"
            file="meshes/dex_cube.obj"
            scale="0.024 0.024 0.024"
        />

    </asset>


    <!-- ========================================================= -->
    <!-- WORLD                                                     -->
    <!-- ========================================================= -->

    <worldbody>


        <!-- ===================================================== -->
        <!-- CUBE BODY                                             -->
        <!-- ===================================================== -->

        <body
            name="cube"
            pos="-0.001 -0.05 0.09"
            quat="1 0 0 0"
            childclass="cube"
        >

            <!-- ================================================= -->
            <!-- FREE JOINT                                        -->
            <!-- ================================================= -->

            <freejoint name="cube_freejoint"/>


            <!-- ================================================= -->
            <!-- VISUAL GEOMETRY                                   -->
            <!-- ================================================= -->

            <!--
                This mesh is ONLY for visualization.

                contype = 0
                conaffinity = 0

                Therefore this mesh does not participate
                in physical collision.
            -->

            <geom
                name="cube_visual"
                type="mesh"
                mesh="cube_mesh"
                material="dexcube"

                contype="0"
                conaffinity="0"

                group="0"
                density="0"

                rgba="1 1 1 1"
            />


            <!-- ================================================= -->
            <!-- COLLISION GEOMETRY                                -->
            <!-- ================================================= -->

            <!--
                This box is the actual collision geometry.

                Size:
                    0.024 x 0.024 x 0.024

                Therefore the full cube size is:
                    0.048 x 0.048 x 0.048 m
                    = 48 x 48 x 48 mm

                It is made invisible using alpha = 0.
            -->

            <geom
                name="cube_collision"
                type="box"
                size="0.024 0.024 0.024"

                contype="1"
                conaffinity="2"

                condim="3"
                friction="1.0 0.01 0.001"

                mass="0.058"
                density="0"

                group="2"

                rgba="0 0 0 0"
            />


            <!-- ================================================= -->
            <!-- CENTER SITE                                       -->
            <!-- ================================================= -->

            <site
                name="cube_center"
                pos="0 0 0"
                group="4"
                size="0.001"
                rgba="1 0 0 1"
            />

        </body>

    </worldbody>


    <!-- ========================================================= -->
    <!-- ACTUATORS / SENSORS CAN BE ADDED HERE                    -->
    <!-- ========================================================= -->

</mujoco>